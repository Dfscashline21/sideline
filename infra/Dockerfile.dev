# Dev container for the sideline monorepo: Python + uv only.
# The repo is bind-mounted at /workspace by compose.yaml, and `uv sync`
# runs when the container starts, so dependencies always match uv.lock.
# DuckDB and the rest of the dev toolchain arrive via that sync.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.13.8 /uv /uvx /usr/local/bin/

WORKDIR /workspace

# Install the venv outside the bind mount so the host's macOS .venv/ is
# never overwritten by Linux binaries (and vice versa).
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_CACHE_DIR=/root/.cache/uv \
    PATH="/opt/venv/bin:$PATH"

CMD ["sleep", "infinity"]
