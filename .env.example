# Copy to .env and adjust. .env is gitignored; never commit real secrets.
# These defaults are fine for local development only.

# Object storage (Silo, a MinIO-compatible server; MINIO_* vars still apply)
MINIO_ROOT_USER=sideline
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Postgres
POSTGRES_USER=sideline
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sideline
POSTGRES_PORT=5432
